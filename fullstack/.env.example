# Disposable local development only. Replace every secret for a deployment.
FASTAPI_ENV=development
PROJECT_NAME="Evios role-aware application"
SECRET_KEY=evios-local-development-secret-at-least-32-bytes
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=evios-local-only
DEMO_PASSWORD=evios-demo-password
POSTGRES_PASSWORD=evios-local-only
DATABASE_URL=postgresql://postgres:evios-local-only@127.0.0.1:55433/app
FRONTEND_HOST=http://127.0.0.1:5174
